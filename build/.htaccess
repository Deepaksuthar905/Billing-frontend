# SPA fallback — React Router (Vite base: /htsuperbilling/)
# Upload build output so this file sits inside the same folder as index.html on the server.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /htsuperbilling/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
